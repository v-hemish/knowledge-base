# Default with `make dev`: browser → same-origin `/api/backend/*` (works on localhost and LAN).
# `make dev` exports BACKEND_URL for the Next server. Optional override:
BACKEND_URL=http://127.0.0.1:8000

# Only set this for direct browser→FastAPI (same machine as the API). Breaks when you open
# the site from another device at http://10.x:3000 (browser would call that device’s 127.0.0.1).
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
