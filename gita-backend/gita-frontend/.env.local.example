# --- Option A: Browser calls FastAPI directly (set CORS on the backend for http://localhost:3000)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Option B: Use the built-in Next proxy (leave NEXT_PUBLIC unset or empty)
# NEXT_PUBLIC_API_BASE_URL=
# Server-side only: where /api/backend/* is forwarded
# BACKEND_URL=http://127.0.0.1:8000
