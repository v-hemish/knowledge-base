# Application
APP_NAME=gita-backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Paths (relative to process CWD unless absolute)
DATA_DIR=./data
DATABASE_PATH=

# Retrieval
FTS_CANDIDATE_LIMIT=24
FINAL_VERSE_COUNT=3
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Precomputed embeddings (see scripts/embed_verses.py); default DATA_DIR/verses_embeddings.npz
EMBEDDINGS_ARTIFACT_PATH=

# OpenAI (sole generation backend). The key is read from backend/.env (gitignored); this
# example file only documents the variable name so secrets do not enter git.
# OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
# Staged rollout: percent of requests routed to OPENAI_MODEL (stable hash by query text).
# Remainder is routed to OPENAI_FALLBACK_MODEL.
GUIDANCE_PRIMARY_MODEL_ROLLOUT_PERCENT=100
OPENAI_TEMPERATURE=0.2
OPENAI_TOP_P=0.9
# OpenAI ``max_completion_tokens`` (GPT-5 family). On reasoning models this includes the
# *internal reasoning* tokens, so 1024 leaves headroom for a short answer after minimal
# reasoning. Raise to 2048+ if you set reasoning_effort above "minimal".
OPENAI_MAX_COMPLETION_TOKENS=1024
OPENAI_CONNECT_TIMEOUT_S=10
OPENAI_READ_TIMEOUT_S=120
OPENAI_WRITE_TIMEOUT_S=60
# Wall-clock cap for one streamed explanation (asyncio timeout around the OpenAI request).
OPENAI_GENERATION_DEADLINE_S=64

# Verses sent into the generation prompt (1 = smallest; client may still show FINAL_VERSE_COUNT cards).
GUIDANCE_GENERATION_MAX_VERSES=1

# When FTS returns zero verses: stream a short general OpenAI reflection (no scripture cards).
# Set false to show only the static no-match notice (no model call). Requires OPENAI_API_KEY when true.
GUIDANCE_OPENAI_WHEN_NO_VERSES=true

# Post-generation validation: word/sentence caps, banned openings, no trailing “See X.Y” line.
GUIDANCE_VALIDATION_MAX_RETRIES=1
GUIDANCE_VALIDATION_MIN_WORDS=20
GUIDANCE_VALIDATION_MAX_WORDS=72
GUIDANCE_VALIDATION_MAX_SENTENCES=3

# Per client IP, sliding 60s window for stream + feedback (0 = off)
GUIDANCE_RATE_LIMIT_PER_MINUTE=60
# Separate higher cap for POST /guidance/retrieve (verse cards, practice UI bursts; 0 = off)
GUIDANCE_RETRIEVE_RATE_LIMIT_PER_MINUTE=300

# Extra delay (seconds) after each streamed explanation chunk; 0 disables.
GUIDANCE_STREAM_CHUNK_DELAY_S=0

# Optional: append one JSON line per POST /api/v1/guidance/feedback (relative → under DATA_DIR).
# GUIDANCE_FEEDBACK_LOG_PATH=guidance_feedback.jsonl

# Retrieve-only in-process cache (0 max entries = off)
RETRIEVE_CACHE_MAX_ENTRIES=128
RETRIEVE_CACHE_TTL_S=60

# Optional: disable semantic rerank for lightweight dev (FTS order only)
SEMANTIC_RERANK_ENABLED=true

# Browser origins allowed when the Next app uses NEXT_PUBLIC_API_BASE_URL (direct to FastAPI).
# Comma-separated, no trailing slashes. Empty defaults to localhost:3000/3001 in ENVIRONMENT=development only.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
